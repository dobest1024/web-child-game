{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crown-gorge",
  "main": "server/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws", "/health"],
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "BattleRoom" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BattleRoom"] }],
  "observability": { "enabled": true },
}
